{
  "name": "nw-service-assurance-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "cf:deploy": "npm run build && npx --yes wrangler@latest deploy",
    "cf:deploy:dry": "npm run build && npx --yes wrangler@latest deploy --dry-run",
    "cf:pages:deploy": "npm run build && npx --yes wrangler@latest pages deploy dist --project-name nw-service-assurance-workbench"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
